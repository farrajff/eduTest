rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'email', 'schoolName'])
        && data.keys().hasOnly([
          'id', 'email', 'name', 'schoolName', 'academicYear',
          'semester', 'teacherName', 'questions', 'exams', 'updatedAt'
        ])
        && data.id == userId
        && data.email is string && data.email.size() <= 200
        && data.schoolName is string && data.schoolName.size() <= 200
        && (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 100))
        && (!('semester' in data) || (data.semester is string && data.semester.size() <= 100))
        && (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 200))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100))
        && (!('questions' in data) || (data.questions is list && data.questions.size() <= 1000))
        && (!('exams' in data) || (data.exams is list && data.exams.size() <= 200));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /questions/{questionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(questionId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(questionId);
      }

      match /exams/{examId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(examId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(examId);
      }
    }
  }
}
